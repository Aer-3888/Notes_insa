while read -r local_ref local_sha remote_ref remote_sha
do
  if [ "$remote_ref" = "refs/heads/dev" ]; then
    # Work out which commits this push would actually add to remote dev. On a
    # brand-new branch remote_sha is all zeros, so just inspect the tip.
    if echo "$remote_sha" | grep -qE '^0+$'; then
      range="-1 $local_sha"
    else
      range="${remote_sha}..${local_sha}"
    fi

    # Already bumped somewhere in this push (retry after the abort below, or a
    # manual bump) — let it through. Scanning the whole range, not just HEAD,
    # means extra commits added before re-pushing don't trigger a second bump.
    if git log $range --pretty=%s | grep -q "^chore(pubspec): bump build number"; then
      continue
    fi

    CURRENT=$(grep '^version: ' pubspec.yaml | sed 's/version: //' | tr -d '[:space:]')
    VERSION_NAME=$(echo "$CURRENT" | cut -d'+' -f1)
    BUILD_NUM=$(echo "$CURRENT" | cut -d'+' -f2)
    NEW_BUILD=$((BUILD_NUM + 1))
    NEW_VERSION="${VERSION_NAME}+${NEW_BUILD}"

    sed -i "s/^version: .*/version: ${NEW_VERSION}/" pubspec.yaml
    git add pubspec.yaml
    git commit -m "chore(pubspec): bump build number to ${NEW_VERSION}"

    echo ""
    echo "pubspec.yaml bumped to ${NEW_VERSION} (one increment per push to dev)."
    echo "Run 'git push' again to push your commits including this bump."
    exit 1
  fi
done

exit 0
