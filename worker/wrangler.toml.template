name = "notesinsa"
main = "src/index.ts"
account_id = "__ACCOUNT_ID__"
compatibility_date = "2024-09-23"
compatibility_flags = ["nodejs_compat"]

[[d1_databases]]
binding = "DB"
database_name = "notes-insa-db"
database_id = "__D1_ID__"

[[kv_namespaces]]
binding = "RATE_LIMIT"
id = "__RATE_LIMIT_KV_ID__"

# Stores the ADE group list refreshed by the daily cron. Kept separate from
# RATE_LIMIT so the binding name does not lie about its contents.
[[kv_namespaces]]
binding = "ADE_CACHE"
id = "__ADE_KV_ID__"

# Caches the WASHiN token and shared laundry snapshot (see laundry.ts).
# Short-lived, non-sensitive data only.
[[kv_namespaces]]
binding = "LAUNDRY_CACHE"
id = "__LAUNDRY_KV_ID__"

[triggers]
crons = ["17 4 * * *"]

[vars]
# APP_SECRET = "SET_THIS_VIA_DASHBOARD"
# IP_SALT = "SET_THIS_VIA_DASHBOARD"

# Required secrets — set via: wrangler secret put <NAME>
# USER_HASH_SALT  — random string used to hash usernames server-side
# APP_SECRET      — shared with the Flutter app via --dart-define
# IP_SALT         — random string used to hash IPs for rate limiting
# WASHIN_USER     — dedicated WASHiN account email for the laundry proxy
# WASHIN_PASS     — password for that WASHiN account
